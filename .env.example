# Empty means same-origin /api/* through server.mjs.
VITE_GLIP_API_BASE_URL=
VITE_GLIP_DEV_MODE=false
VITE_GLIP_DEV_TENANT_ID=
VITE_GLIP_DEV_USER_ID=

# Optional public convenience only; tenant is still submitted explicitly at login.
VITE_GLIP_DEFAULT_TENANT_ID=

# Server-side only; never exposed to Vite/browser.
GLIP_BACKEND_URL=http://glip-backend.railway.internal:8080

VITE_GLIP_CASE_ASSET_MODE=remote
GLIP_RELEASE_ID=1.0.0rc7
